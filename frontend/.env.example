# Agriculture Equipment Rental System - Frontend Environment Variables

# API Configuration
# Use the backend origin here. The app appends /api automatically.
REACT_APP_API_URL=http://localhost:5000

# Application Configuration
REACT_APP_NAME=Agriculture Equipment Rental System
REACT_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_PAYMENT_GATEWAY=false
REACT_APP_ENABLE_CHAT_SUPPORT=false

# Upload Configuration
REACT_APP_MAX_FILE_SIZE=5242880
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Map Configuration (for location features)
# Get your API key from: https://console.cloud.google.com/
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Payment Gateway (when enabled)
# Get your key from: https://dashboard.stripe.com/
REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# Analytics (optional)
# Get your ID from: https://analytics.google.com/
REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Environment
REACT_APP_ENV=development
